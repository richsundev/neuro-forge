# Copy to .env and adjust as needed. Every value has a working local default (SQLite, no auth
# bootstrap key needed) — you only need this file for non-default configuration.

# --- database ---------------------------------------------------------
# Local/CI default: sqlite:///./neuroforge.db
# docker-compose / production: postgresql+psycopg2://neuroforge:neuroforge@postgres:5432/neuroforge
NEUROFORGE_DATABASE_URL=sqlite:///./neuroforge.db

# --- async worker queue -------------------------------------------------
NEUROFORGE_REDIS_URL=redis://localhost:6379/0

# --- experiment state (checkpoints + event logs) -------------------------
NEUROFORGE_STATE_DIR=./neuroforge_state

# --- API auth -----------------------------------------------------------
# If unset, a random admin key is generated on first startup and logged once — see
# `docker compose logs api | grep "Bootstrap admin"`. Set this to pin a known key instead
# (useful for local dev / CI so you don't have to scrape logs).
NEUROFORGE_BOOTSTRAP_API_KEY=

# --- real model providers (optional — mock mode needs none of this) ------
NEUROFORGE_OPENAI_BASE_URL=
NEUROFORGE_OPENAI_API_KEY=
NEUROFORGE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
NEUROFORGE_ANTHROPIC_API_KEY=

# --- dashboard (apps/dashboard/.env.local) -------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
